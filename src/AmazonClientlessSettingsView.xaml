<UserControl x:Class="AmazonClientless.AmazonClientlessSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AmazonClientless"
             xmlns:pcmd="clr-namespace:PlayniteMod.Commands"
             xmlns:common="clr-namespace:CommonPlugin" xmlns:system="clr-namespace:System"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:AmazonClientlessSettingsHandler}"
             d:DesignHeight="600" d:DesignWidth="800" Initialized="AmazonClientlessSettingsView_OnInitialized">

    <TabControl ScrollViewer.VerticalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <TabItem Header="{common:Localize Key={x:Static system:LOC.ThirdPartyPlayniteSettingsGeneralLabel}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <CheckBox DockPanel.Dock="Top" Name="AmazonImportInstalledChk"
                              Margin="0,0,0,15"
                              IsChecked="{Binding Settings.ImportInstalledGames}"
                              Content="{common:Localize Key={x:Static system:LOC.ThirdPartyAmazonSettingsImportInstalledLabel}}" />

                    <CheckBox DockPanel.Dock="Top" Name="AmazonConnectAccountChk"
                              IsChecked="{Binding Settings.ConnectAccount}"
                              Content="{common:Localize Key={x:Static system:LOC.ThirdPartyAmazonSettingsConnectAccount}}"
                              Checked="AmazonConnectAccountChk_Checked" />

                    <StackPanel DockPanel.Dock="Top" Margin="40,5,5,5"
                                IsEnabled="{Binding IsChecked, ElementName=AmazonConnectAccountChk}">

                        <CheckBox DockPanel.Dock="Top" Name="AmazonImportUninstalledChk"
                                  IsChecked="{Binding Settings.ImportUninstalledGames}"
                                  Margin="0,10,0,0"
                                  Content="{common:Localize Key={x:Static system:LOC.ThirdPartyAmazonSettingsImportUninstalledLabel}}" />

                        <StackPanel Orientation="Horizontal"
                                    DockPanel.Dock="Top" Margin="0,15,5,5" HorizontalAlignment="Left">
                            <ToggleButton HorizontalAlignment="Left" Name="LoginBtn"
                                          Content="{common:Localize Key={x:Static system:LOC.ThirdPartyAmazonAuthenticateLabel}}"
                                          IsChecked="False" Click="LoginBtn_Click" />
                            <TextBlock VerticalAlignment="Center" Margin="10,5,5,5" Name="AuthStatusTB"
                                       Text="{common:Localize Key={x:Static system:LOC.ThirdPartyAmazonLoginChecking}}">
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,20,0,0">
                        <TextBlock
                            Text="{common:Localize Key={x:Static system:LOC.ThirdPartyPlayniteExtensionsUpdates}}"
                            FontSize="18"
                            Margin="0,0,0,2" />
                        <Separator Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="{common:Localize Key={x:Static system:LOC.CommonGamesUpdatePolicy}}"
                                       VerticalAlignment="Center" HorizontalAlignment="Left">
                            </TextBlock>
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="GamesUpdatesCBo" DisplayMemberPath="Value"
                                      SelectedValue="{Binding Settings.GamesUpdatePolicy}" SelectedValuePath="Key"
                                      VerticalContentAlignment="Center" HorizontalContentAlignment="Left"
                                      HorizontalAlignment="Left" Margin="10,0,0,0"
                                      SelectionChanged="GamesUpdatesCBo_SelectionChanged" />
                        </StackPanel>
                        <CheckBox Content="{common:Localize Key={x:Static system:LOC.CommonAutoUpdate}}"
                                  Margin="0,0,0,8" Name="AutoUpdateGamesChk"
                                  IsChecked="{Binding Settings.AutoUpdateGames}">
                        </CheckBox>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="{common:Localize Key={x:Static system:LOC.CommonDownloadSettings}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <CheckBox Grid.Column="0" Grid.Row="5"
                              Content="{common:Localize Key={x:Static system:LOC.CommonUnattendedInstall}}"
                              ToolTip="{common:Localize Key={x:Static system:LOC.CommonUnattendedInstallToolTip}}"
                              IsChecked="{Binding Settings.UnattendedInstall}" Margin="0,0,0,8 " />
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="{common:Localize Key={x:Static system:LOC.CommonGamesInstallationPath}}"
                                   Grid.Row="1" Grid.Column="0"
                                   Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                        </TextBlock>
                        <Button Margin="5 0 0 0" DockPanel.Dock="Right"
                                Name="ChooseGamePathBtn" Click="ChooseGamePathBtn_Click" Content="&#xec5b;"
                                FontFamily="{DynamicResource FontIcoFont}"
                                ToolTip="{common:Localize Key={x:Static system:LOC.ThirdPartyPlayniteSelectDirectoryTooltip}}"
                                VerticalAlignment="Center" />
                        <TextBox Name="SelectedGamePathTxt"
                                 Text="{Binding Settings.GamesInstallationPath, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="Left" Width="Auto" />
                            <ColumnDefinition x:Name="Right" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{common:Localize Key={x:Static system:LOC.CommonMaxWorkers}}" Grid.Column="0"
                                   Grid.Row="0" Margin="0,0,15,8" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <common:NumericInput Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" MinValue="0"
                                             x:Name="MaxWorkersNI" Value="{Binding Settings.MaxWorkers}"
                                             HorizontalAlignment="Left" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="{common:Localize Key={x:Static system:LOC.ThirdPartyPlayniteSettingsAdvancedLabel}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <StackPanel>
                        <TextBlock Text="{common:Localize Key={x:Static system:LOC.CommonCache}}" FontSize="18"
                                   Margin="0,0,0,2" />
                        <Separator Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="{common:Localize Key={x:Static system:LOC.CommonAutoClearCache}}"
                                       Margin="0,0,0,8" VerticalAlignment="Center" HorizontalAlignment="Left">
                            </TextBlock>
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="AutoClearCacheCBo" DisplayMemberPath="Value"
                                      SelectedValue="{Binding Settings.AutoClearCache}" SelectedValuePath="Key"
                                      VerticalContentAlignment="Center" HorizontalContentAlignment="Left"
                                      Margin="10,0,0,8" HorizontalAlignment="Left" />
                            <Button Grid.Row="1" Content="{common:Localize Key={x:Static system:LOC.CommonClearCache}}"
                                    Name="ClearCacheBtn" Click="ClearCacheBtn_Click" HorizontalAlignment="Left" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="{common:Localize Key={x:Static system:LOC.CommonTroubleshootingInformation}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{common:Localize Key={x:Static system:LOC.CommonPlayniteVersion}}"
                                   Grid.Column="0" Grid.Row="0"
                                   Margin="0,0,8,8" VerticalAlignment="Center">
                        </TextBlock>
                        <TextBox x:Name="PlayniteVersionTxt" Grid.Column="1" Grid.Row="0" Margin="0,0,0,8"
                                 VerticalAlignment="Bottom" IsReadOnly="True" HorizontalAlignment="Left" />
                        <TextBlock Text="{common:Localize Key={x:Static system:LOC.CommonPluginVersion}}"
                                   Grid.Column="0" Grid.Row="1"
                                   Margin="0,0,10,8" VerticalAlignment="Center" />
                        <TextBox x:Name="PluginVersionTxt" Grid.Column="1" Grid.Row="1" Margin="0,0,0,8"
                                 VerticalAlignment="Center" IsReadOnly="True" HorizontalAlignment="Left" />
                        <TextBlock Text="{common:Localize Key={x:Static system:LOC.CommonGamesInstallationPath}}"
                                   Grid.Row="6" Grid.Column="0"
                                   Margin="0,0,10,8" VerticalAlignment="Center" />
                        <TextBox x:Name="GamesInstallationPathTxt" Margin="0,0,0,8" VerticalAlignment="Center"
                                 IsReadOnly="True" Grid.Column="1" Grid.Row="6" />
                        <Button x:Name="OpenGamesInstallationPathBtn" Margin="10,0,0,8"
                                Content="{common:Localize Key={x:Static system:LOC.ThirdPartyPlayniteOpen}}"
                                VerticalAlignment="Center" Click="OpenGamesInstallationPathBtn_Click" Grid.Column="2"
                                Grid.Row="6" />
                        <Button Margin="0,15,8,8" Grid.Column="0" Grid.Row="8" Name="CopyRawDataBtn"
                                Click="CopyRawDataBtn_Click"
                                Grid.ColumnSpan="2" HorizontalAlignment="Left"
                                Content="{common:Localize Key={x:Static system:LOC.CommonCopyRawDataToClipboard}}" />
                        <TextBlock VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Grid.Column="0"
                                   Grid.Row="9" Margin="0,10,0,0">
                            <Hyperlink
                                NavigateUri="https://github.com/hawkeye116477/playnite-nile-plugin/wiki/troubleshooting"
                                Command="{x:Static pcmd:Commands.OpenUrlCommand}"
                                CommandParameter="{Binding NavigateUri, RelativeSource={RelativeSource Self}}">
                                <Run
                                    Text="{common:Localize Key={x:Static system:LOC.ThirdPartyAmazonTroubleShootingIssues}}" />
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Grid.Column="0"
                                   Grid.Row="10" Margin="0,10,0,0">
                            <Hyperlink
                                Name="ReportBugHyp"
                                Command="{x:Static pcmd:Commands.OpenUrlCommand}"
                                CommandParameter="{Binding NavigateUri, RelativeSource={RelativeSource Self}}">
                                <Run Text="{common:Localize Key={x:Static system:LOC.CommonReportBug}}" />
                            </Hyperlink>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>

</UserControl>